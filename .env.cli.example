# Used by `vf setup` so the token is not exposed in shell history.
# Create a Cloudflare API token that can read Workers AI model metadata.
VIBEFLARE_CF_API_TOKEN=

# Optional: provide your own stable session secret instead of letting setup
# generate one. Use at least 32 random bytes.
VIBEFLARE_SESSION_SECRET=

# Optional advanced override: use your own GitHub OAuth App Device Flow client id.
# Leave empty for VibeFlare's zero-config GitHub App Manifest setup.
VIBEFLARE_GITHUB_CLIENT_ID=

# Only for `vf setup --mode=cf-access`.
VIBEFLARE_CF_ACCESS_TEAM=
VIBEFLARE_CF_ACCESS_AUD=
