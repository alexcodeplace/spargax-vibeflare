# VibeFlare standalone setup is zero-secret: session signing self-initializes in
# D1 and the Workers AI catalog is fetched from Cloudflare's public catalog.

# Optional advanced override: use your own GitHub OAuth App Device Flow client id.
# Leave empty for VibeFlare's zero-config GitHub App Manifest setup.
VIBEFLARE_GITHUB_CLIENT_ID=

# Only for `vf setup --mode=cf-access`.
VIBEFLARE_CF_ACCESS_TEAM=
VIBEFLARE_CF_ACCESS_AUD=
