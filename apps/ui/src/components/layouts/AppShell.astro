---
import Sidebar from './Sidebar.astro';
import TopBar from './TopBar.astro';
export interface Props { title?: string }
const { title } = Astro.props;
---
<div class="vf-workspace">
  <Sidebar />
  <div id="sidebar-backdrop" class="vf-sidebar-backdrop fixed inset-0 z-40 bg-black/50 lg:hidden" aria-hidden="true"></div>
  <div class="vf-workspace-main">
    <TopBar title={title} />
    <main id="main-content" class:list={['vf-main', { 'vf-main--chat': Astro.url.pathname === '/chat' }]} tabindex="-1">
      <slot />
    </main>
  </div>
</div>
