---
import { DailyUsage } from '../widgets/DailyUsage';
import { ThemeToggle } from '../widgets/ThemeToggle';
import BrandIcon from '../brand/BrandIcon.astro';
export interface Props { title?: string }
const { title = 'Workspace' } = Astro.props;
---
<header class="vf-topbar">
  <div class="vf-topbar-heading">
    <button id="menu-toggle" class="vf-icon-button lg:hidden" type="button" aria-label="Toggle menu" aria-controls="sidebar" aria-expanded="false"><BrandIcon name="menu" /></button>
    <div><span class="vf-eyebrow">SPARGAX VIBEFLARE</span><span class="vf-page-title">{title}</span></div>
  </div>
  <div class="vf-topbar-actions">
    <div class="vf-quota"><DailyUsage compact client:only="react" /></div>
    <ThemeToggle client:only="react" />
  </div>
</header>
