---
export interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<a class:list={['vf-brand', { 'vf-brand--compact': compact }]} href="/" aria-label="VibeFlare home">
  {compact ? <img class="vf-brand-symbol" src="/assets/brand/vibeflare-mark.webp" width="44" height="36" alt="VibeFlare" decoding="async" />
    : <img class="vf-brand-logo" src="/assets/brand/vibeflare-wordmark-320.webp" srcset="/assets/brand/vibeflare-wordmark-320.webp 320w, /assets/brand/vibeflare-wordmark-640.webp 640w" sizes="(max-width: 700px) 156px, 184px" width="184" height="48" alt="VibeFlare" decoding="async" fetchpriority="high" />}
</a>
