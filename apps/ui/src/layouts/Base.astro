---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/brand.css';
import '../styles/controls.css';
import '../styles/task-workspace.css';
import '@platform-modules/ui-accessibility/styles.css';
import '../styles/accessibility.css';

export interface Props {
  title?: string;
  bodyClass?: string;
  /** Emit <meta name="referrer" content="no-referrer"> to suppress Referer header (e.g. /signup). */
  noReferrer?: boolean;
}

const { title = 'VibeFlare', bodyClass = 'h-screen overflow-hidden bg-[var(--color-bg)]', noReferrer = false } = Astro.props;
---
<!doctype html>
<html lang="en" data-astryx-theme="neutral" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#061329" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {noReferrer && <meta name="referrer" content="no-referrer" />}
  <ClientRouter />
  <!-- Inline initialization prevents a light/dark flash before the first paint. -->
  <script is:inline>
    (() => {
      let mode = 'dark';
      try { mode = localStorage.getItem('vf-theme') === 'light' ? 'light' : 'dark'; } catch {}
      document.documentElement.dataset.theme = mode;
    })();
  </script>
  <script>
    import { mountAccessibility, type AccessibilityController } from '@platform-modules/ui-accessibility/browser';
    import { accessibilityReportHref } from '../lib/accessibility-copy';
    let accessibility: AccessibilityController | undefined;
    const mountPanel = () => {
      accessibility?.destroy();
      try {
        const locale = document.documentElement.lang === 'he' ? 'he' : document.documentElement.lang === 'es' ? 'es' : 'en';
        accessibility = mountAccessibility({ document, locale, storageKey: 'spargax.a11y.v1', statementHref: '/accessibility', reportHref: accessibilityReportHref });
      } catch (error) { console.error('Accessibility controls could not initialize', error); }
    };
    document.addEventListener('astro:before-swap', () => { accessibility?.destroy(); accessibility = undefined; });
    document.addEventListener('astro:page-load', mountPanel);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountPanel, { once: true });
    else mountPanel();
    import { initTheme } from '../lib/theme';
    import { initBrandInteractions } from '../lib/brand-interactions';
    const boot = () => { initTheme(); initBrandInteractions(); };
    boot();
    document.addEventListener('astro:page-load', boot);
    document.addEventListener('astro:after-swap', initTheme);
  </script>
</head>
<body class={bodyClass}>
  <a class="vf-skip-link" href="#main-content">Skip to content</a>
  <slot />
</body>
</html>
