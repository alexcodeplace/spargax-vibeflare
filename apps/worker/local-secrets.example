# Copy this file to .dev.vars for local development (wrangler dev reads it as secrets)
# .dev.vars is gitignored — never commit it

# Required
SESSION_SECRET=        # generate: openssl rand -hex 32

# Optional advanced override for GitHub Device Flow.
# Leave empty to use zero-config GitHub App Manifest setup on first run.
GITHUB_CLIENT_ID=

# Cloudflare Access (Path 1 / enterprise mode only — leave empty for workers.dev OSS mode)
# CF_ACCESS_TEAM=      # e.g. myteam (from https://myteam.cloudflareaccess.com)
# CF_ACCESS_AUD=       # Application Audience Tag from CF Access dashboard
